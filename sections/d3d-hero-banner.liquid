{% comment %}
  Decora3D — Hero Banner Section
  Full-width dark hero with gold typography and dual CTAs
{% endcomment %}

<section class="d3d-hero" id="d3d-hero">
  {% if section.settings.bg_image != blank %}
    <div class="d3d-hero__bg-image" style="
      position: absolute; inset: 0; z-index: 0;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover; background-position: center;
      filter: brightness({{ 100 | minus: section.settings.overlay_opacity }}%);
    "></div>
    <div class="d3d-hero__overlay" style="
      position: absolute; inset: 0; z-index: 1;
      background: rgba(10,9,6,{{ section.settings.overlay_opacity | divided_by: 100.0 }});
    "></div>
  {% else %}
    <div class="d3d-hero__bg" style="position: absolute; inset: 0; z-index: 0;
      background: radial-gradient(ellipse at 20% 50%, #1a1400 0%, #0f0f0f 60%, #000 100%);
    "></div>
    <!-- Decorative grid -->
    <div style="position: absolute; inset: 0; z-index: 1; opacity: 0.04;
      background-image: linear-gradient(#C8A84B 1px, transparent 1px), linear-gradient(90deg, #C8A84B 1px, transparent 1px);
      background-size: 40px 40px;
    "></div>
  {% endif %}

  <div class="d3d-page-width" style="position: relative; z-index: 2; width: 100%;">
    <div class="d3d-hero__content">
      {% if section.settings.eyebrow != blank %}
        <span class="d3d-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      <h1 class="d3d-hero__headline">
        {{ section.settings.headline | newline_to_br }}
      </h1>

      {% if section.settings.subtext != blank %}
        <p class="d3d-hero__sub">{{ section.settings.subtext }}</p>
      {% endif %}

      <div class="d3d-hero__buttons">
        {% if section.settings.btn1_text != blank %}
          <a href="{{ section.settings.btn1_link }}" class="d3d-hero__btn--primary">
            {{ section.settings.btn1_text }}
          </a>
        {% endif %}
        {% if section.settings.btn2_text != blank %}
          <a href="{{ section.settings.btn2_link }}" class="d3d-hero__btn--secondary">
            {{ section.settings.btn2_text }}
          </a>
        {% endif %}
      </div>

      <!-- Studio stats strip -->
      <div style="display: flex; gap: 32px; margin-top: 50px; padding-top: 30px; border-top: 1px solid #2a2a2a; flex-wrap: wrap;">
        <div>
          <div style="font-family: 'Anton', sans-serif; font-size: 2rem; color: #E8D5A0; letter-spacing: 2px;">28+</div>
          <div style="font-size: 11px; color: #666; letter-spacing: 2px; text-transform: uppercase;">Unique Products</div>
        </div>
        <div>
          <div style="font-family: 'Anton', sans-serif; font-size: 2rem; color: #E8D5A0; letter-spacing: 2px;">1040</div>
          <div style="font-size: 11px; color: #666; letter-spacing: 2px; text-transform: uppercase;">Sq.ft Studio</div>
        </div>
        <div>
          <div style="font-family: 'Anton', sans-serif; font-size: 2rem; color: #E8D5A0; letter-spacing: 2px;">3D</div>
          <div style="font-size: 11px; color: #666; letter-spacing: 2px; text-transform: uppercase;">Printed in Delhi</div>
        </div>
        <div>
          <div style="font-family: 'Anton', sans-serif; font-size: 2rem; color: #E8D5A0; letter-spacing: 2px;">24h</div>
          <div style="font-size: 11px; color: #666; letter-spacing: 2px; text-transform: uppercase;">Custom Turnaround</div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "D3D Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "DELHI NCR'S FIRST 3D PRINTING EXPERIENCE STUDIO"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline (use new line for line breaks)",
      "default": "IMAGINE IT.\nPRINT IT.\nOWN IT."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Unique 3D printed home decor, lamps, wall art & corporate gifts. Made in Delhi NCR."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "SHOP PRODUCTS"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "VISIT THE STUDIO"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (optional)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 60,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "D3D Hero Banner"
    }
  ]
}
{% endschema %}
