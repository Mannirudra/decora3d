{% comment %}
  Decora3D — Trust Badges Row
  5 trust signals displayed in a horizontal row
{% endcomment %}

<div class="d3d-trust shopify-section">
  <div class="d3d-page-width">
    <div class="d3d-trust__grid">

      <div class="d3d-trust__item">
        <div class="d3d-trust__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C8A84B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="d3d-trust__label">FREE SHIPPING</div>
        <div class="d3d-trust__sub">Orders above ₹999</div>
      </div>

      <div class="d3d-trust__item">
        <div class="d3d-trust__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C8A84B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <div class="d3d-trust__label">PAN INDIA DELIVERY</div>
        <div class="d3d-trust__sub">5–7 business days</div>
      </div>

      <div class="d3d-trust__item">
        <div class="d3d-trust__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C8A84B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <div class="d3d-trust__label">MADE IN INDIA</div>
        <div class="d3d-trust__sub">Delhi NCR Studio</div>
      </div>

      <div class="d3d-trust__item">
        <div class="d3d-trust__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C8A84B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="d3d-trust__label">SECURE PAYMENTS</div>
        <div class="d3d-trust__sub">Razorpay · UPI · COD</div>
      </div>

      <div class="d3d-trust__item">
        <div class="d3d-trust__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C8A84B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div class="d3d-trust__label">WHATSAPP SUPPORT</div>
        <div class="d3d-trust__sub">Mon–Sat, 10AM–7PM</div>
      </div>

    </div>
  </div>
</div>

