{% comment %}
  Decora3D — Corporate Gold Strip Section
{% endcomment %}

<section class="d3d-corp-strip shopify-section">
  <div class="d3d-page-width">
    {% if section.settings.label != blank %}
      <span class="d3d-corp-strip__label">{{ section.settings.label }}</span>
    {% endif %}
    <h2 class="d3d-corp-strip__headline">{{ section.settings.headline }}</h2>
    {% if section.settings.subtext != blank %}
      <p class="d3d-corp-strip__sub">{{ section.settings.subtext }}</p>
    {% endif %}

    <!-- Package highlights -->
    <div style="display: flex; justify-content: center; gap: 20px; margin-bottom: 32px; flex-wrap: wrap;">
      <div style="text-align: center; padding: 16px 24px; border: 1px solid #4a3500; border-radius: 4px; min-width: 140px;">
        <div style="font-family: 'Anton', sans-serif; color: #E8D5A0; font-size: 1.4rem; letter-spacing: 1px;">BASIC</div>
        <div style="color: #C8A84B; font-size: 1.1rem; font-weight: 600; margin: 4px 0;">₹599/unit</div>
        <div style="color: #666; font-size: 11px; letter-spacing: 1px;">MIN 25 UNITS</div>
      </div>
      <div style="text-align: center; padding: 16px 24px; border: 2px solid #C8A84B; border-radius: 4px; min-width: 140px; background: rgba(200,168,75,0.06);">
        <div style="font-family: 'Anton', sans-serif; color: #E8D5A0; font-size: 1.4rem; letter-spacing: 1px;">PREMIUM</div>
        <div style="color: #C8A84B; font-size: 1.1rem; font-weight: 600; margin: 4px 0;">₹1,499/unit</div>
        <div style="color: #C8A84B; font-size: 11px; letter-spacing: 1px;">MIN 25 UNITS ⭐</div>
      </div>
      <div style="text-align: center; padding: 16px 24px; border: 1px solid #4a3500; border-radius: 4px; min-width: 140px;">
        <div style="font-family: 'Anton', sans-serif; color: #E8D5A0; font-size: 1.4rem; letter-spacing: 1px;">EXECUTIVE</div>
        <div style="color: #C8A84B; font-size: 1.1rem; font-weight: 600; margin: 4px 0;">CUSTOM</div>
        <div style="color: #666; font-size: 11px; letter-spacing: 1px;">MIN 50 UNITS</div>
      </div>
    </div>

    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="d3d-corp-strip__btn">
        {{ section.settings.btn_text }} →
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "D3D Corporate Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "CORPORATE GIFTING & BULK ORDERS"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "MAKE YOUR BRAND UNFORGETTABLE"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "GET A QUOTE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "D3D Corporate Strip"
    }
  ]
}
{% endschema %}
